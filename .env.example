# Copia este archivo a `.env` y ajusta los valores si lo necesitas.
# NUNCA subas el archivo `.env` real a un repositorio público.

# Puerto del backend (Express)
PORT=3001

# Origen permitido para CORS. Déjalo vacío para aceptar cualquier
# localhost durante el desarrollo (la app de escritorio usará un origen propio).
CLIENT_ORIGIN=
